    grid-template-columns: 1fr;
    gap: 48px;
  }

  .about-float-card { right: 12px; }

  .steps-grid,
  .opp-grid,
  .resp-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .steps-grid::before { display: none; }

  .skills-cards,
  .sector-grid,
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .compare-grid {
    grid-template-columns: 1fr;
  }

  .compare-vs {
    padding: 22px 0;
  }

  .split-banner {
    grid-template-columns: 1fr;
  }

  .split-banner img { min-height: 260px; }

  .tab-panel-inner {
    grid-template-columns: 1fr;
    padding: 30px;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 38px;
  }
}

@media (max-width: 760px) {
  body { font-size: 16px; }

  .section { padding-block: 74px; }

  .hero { min-height: auto; padding-top: 130px; padding-bottom: 70px; }

  .hero-stats { grid-template-columns: 1fr; gap: 10px; }
  .hero-stat { display: flex; align-items: center; gap: 14px; padding: 14px 18px; }
  .hero-stat .num { font-size: 1.4rem; }
  .hero-stat .lbl { margin-top: 0; }

  .hero-actions { flex-direction: column; align-items: stretch; }
  .hero-actions .btn { width: 100%; }

  .scroll-hint { display: none; }

  .threat-grid,
  .steps-grid,
  .opp-grid,
  .resp-grid,
  .skills-cards,
  .sector-grid,
  .stats-grid,
  .mini-features {
    grid-template-columns: 1fr;
  }

  .chart-wrap { padding: 26px 18px; }
  .chart-canvas-box { height: 260px; }

  .quiz-box { padding: 28px 22px; }
  .quiz-question { font-size: 1.08rem; }

  .compare-col { padding: 32px 24px; }

  .footer-grid { grid-template-columns: 1fr; gap: 34px; }

  .footer-bottom { flex-direction: column; text-align: center; }

  .about-float-card { display: none; }

  .timeline { padding-left: 34px; }
  .tl-item::before { left: -30px; }

  #back-to-top { right: 16px; bottom: 16px; width: 46px; height: 46px; }

  .ticker::before, .ticker::after { width: 60px; }
}

@media (max-width: 460px) {
  .container { padding-inline: 18px; }
  .brand-text small { display: none; }
  .card { padding: 26px 22px; }
  .step-card { padding: 30px 22px; }
  .tab-buttons { gap: 8px; }
  .tab-btn { padding: 9px 16px; font-size: 0.82rem; }
}

/* Acessibilidade: reduzir movimento */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}

/* Impressão */
@media print {
  .navbar, #back-to-top, .scroll-hint, #preloader,
  .cursor-dot, .cursor-ring, #scroll-progress, .ticker { display: none !important; }
  body { background: #fff; color: #000; }
  .section { padding-block: 24px; page-break-inside: avoid; }
}
