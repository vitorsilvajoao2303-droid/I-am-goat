<style>
/* ==========================================================================
   1. VARIÁVEIS E RESET
   ========================================================================== */
:root {
  /* Paleta principal */
  --c-bg:            #0a0e1a;
  --c-bg-alt:        #0f1523;
  --c-bg-soft:       #131b2c;
  --c-surface:       #16203a;
  --c-surface-2:     #1b2743;
  --c-border:        rgba(255, 255, 255, 0.08);
  --c-border-strong: rgba(255, 255, 255, 0.16);

  /* Cores de destaque */
  --c-primary:       #00d4ff;
  --c-primary-dark:  #0095c9;
  --c-primary-glow:  rgba(0, 212, 255, 0.35);
  --c-secondary:     #7c5cff;
  --c-secondary-glow:rgba(124, 92, 255, 0.35);
  --c-accent:        #ff4d8d;
  --c-success:       #2ce08a;
  --c-warning:       #ffb020;
  --c-danger:        #ff5252;

  /* Texto */
  --c-text:          #eaf0ff;
  --c-text-soft:     #b3c0d8;
  --c-text-muted:    #7a879e;

  /* Gradientes */
  --grad-primary:    linear-gradient(135deg, #00d4ff 0%, #7c5cff 100%);
  --grad-secondary:  linear-gradient(135deg, #7c5cff 0%, #ff4d8d 100%);
  --grad-success:    linear-gradient(135deg, #2ce08a 0%, #00d4ff 100%);
  --grad-danger:     linear-gradient(135deg, #ff5252 0%, #ff4d8d 100%);
  --grad-surface:    linear-gradient(180deg, rgba(22,32,58,0.9) 0%, rgba(10,14,26,0.9) 100%);
  --grad-hero:       radial-gradient(ellipse at 20% 20%, rgba(0,212,255,0.18), transparent 55%),
                     radial-gradient(ellipse at 80% 30%, rgba(124,92,255,0.20), transparent 55%),
                     radial-gradient(ellipse at 50% 100%, rgba(255,77,141,0.12), transparent 60%);

  /* Sombras */
  --shadow-sm:  0 2px 8px rgba(0, 0, 0, 0.25);
  --shadow-md:  0 8px 24px rgba(0, 0, 0, 0.35);
  --shadow-lg:  0 20px 50px rgba(0, 0, 0, 0.45);
  --shadow-glow:0 0 40px rgba(0, 212, 255, 0.25);

  /* Layout */
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 22px;
  --radius-xl: 32px;
  --radius-pill: 999px;

  --container: 1240px;
  --nav-h: 78px;

  /* Tipografia */
  --f-body: 'Inter', system-ui, -apple-system, sans-serif;
  --f-head: 'Space Grotesk', 'Inter', sans-serif;
  --f-mono: 'JetBrains Mono', ui-monospace, monospace;

  /* Transições */
  --t-fast: 0.18s cubic-bezier(0.4, 0, 0.2, 1);
  --t-med:  0.32s cubic-bezier(0.4, 0, 0.2, 1);
  --t-slow: 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

/* Tema claro */
[data-theme="light"] {
  --c-bg:            #f4f7fc;
  --c-bg-alt:        #eaf0fa;
  --c-bg-soft:       #ffffff;
  --c-surface:       #ffffff;
  --c-surface-2:     #eef3fb;
  --c-border:        rgba(10, 20, 45, 0.09);
  --c-border-strong: rgba(10, 20, 45, 0.18);

  --c-text:          #0b1225;
  --c-text-soft:     #3c4a63;
  --c-text-muted:    #6b7a94;

  --c-primary:       #0089c4;
  --c-primary-dark:  #006a99;
  --c-primary-glow:  rgba(0, 137, 196, 0.22);
  --c-secondary:     #5b3fd6;
  --c-secondary-glow:rgba(91, 63, 214, 0.22);
  --c-accent:        #e02b6f;

  --grad-hero:       radial-gradient(ellipse at 20% 20%, rgba(0,137,196,0.14), transparent 55%),
                     radial-gradient(ellipse at 80% 30%, rgba(91,63,214,0.14), transparent 55%),
                     radial-gradient(ellipse at 50% 100%, rgba(224,43,111,0.10), transparent 60%);

  --shadow-sm:  0 2px 8px rgba(10, 25, 60, 0.08);
  --shadow-md:  0 8px 24px rgba(10, 25, 60, 0.10);
  --shadow-lg:  0 20px 50px rgba(10, 25, 60, 0.14);
  --shadow-glow:0 0 40px rgba(0, 137, 196, 0.18);
}

*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--nav-h) + 16px);
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--f-body);
  background-color: var(--c-bg);
  color: var(--c-text);
  line-height: 1.72;
  font-size: 16.5px;
  overflow-x: hidden;
  transition: background-color var(--t-med), color var(--t-med);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body.no-scroll {
  overflow: hidden;
}

img {
  max-width: 100%;
  display: block;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
  transition: color var(--t-fast);
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  background: none;
  color: inherit;
}

ul, ol {
  list-style: none;
}

::selection {
  background: var(--c-primary);
  color: #04121c;
}

/* Barra de rolagem personalizada */
::-webkit-scrollbar {
  width: 11px;
  height: 11px;
}
::-webkit-scrollbar-track {
  background: var(--c-bg-alt);
}
::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, var(--c-primary), var(--c-secondary));
  border-radius: 10px;
  border: 2px solid var(--c-bg-alt);
}
::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, var(--c-secondary), var(--c-accent));
}

/* ==========================================================================
   2. UTILITÁRIOS
   ========================================================================== */
.container {
  width: 100%;
  max-width: var(--container);
  margin-inline: auto;
  padding-inline: 24px;
}

.section {
  position: relative;
  padding-block: 110px;
}

.section--tight {
  padding-block: 70px;
}

.section--alt {
  background: var(--c-bg-alt);
}

.section-head {
  max-width: 800px;
  margin: 0 auto 64px;
  text-align: center;
}

.section-head--left {
  margin-inline: 0;
  text-align: left;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-family: var(--f-mono);
  font-size: 12.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--c-primary);
  background: rgba(0, 212, 255, 0.08);
  border: 1px solid rgba(0, 212, 255, 0.22);
  padding: 7px 16px;
  border-radius: var(--radius-pill);
  margin-bottom: 22px;
}

.eyebrow::before {
  content: '';
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--c-primary);
  box-shadow: 0 0 12px var(--c-primary);
  animation: pulseDot 2s ease-in-out infinite;
}

@keyframes pulseDot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.35; transform: scale(0.75); }
}

.section-title {
  font-family: var(--f-head);
  font-size: clamp(1.9rem, 4vw, 3rem);
  font-weight: 700;
  line-height: 1.16;
  letter-spacing: -0.02em;
  margin-bottom: 18px;
}

.section-sub {
  font-size: 1.06rem;
  color: var(--c-text-soft);
  line-height: 1.8;
}

.grad-text {
  background: var(--grad-primary);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

.grad-text--warm {
  background: var(--grad-secondary);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

.grad-text--success {
  background: var(--grad-success);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

.grad-text--danger {
  background: var(--grad-danger);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}

/* Botões */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-family: var(--f-head);
  font-size: 0.95rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  padding: 14px 30px;
  border-radius: var(--radius-pill);
  border: 1px solid transparent;
  transition: transform var(--t-fast), box-shadow var(--t-fast),
              background var(--t-fast), border-color var(--t-fast), color var(--t-fast);
  position: relative;
  overflow: hidden;
  white-space: nowrap;
}

.btn svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  transition: transform var(--t-fast);
}

.btn:hover svg {
  transform: translateX(3px);
}

.btn--primary {
  background: var(--grad-primary);
  color: #04121c;
  box-shadow: 0 8px 26px rgba(0, 212, 255, 0.28);
}

.btn--primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 36px rgba(0, 212, 255, 0.42);
}

.btn--ghost {
  background: transparent;
  border-color: var(--c-border-strong);
  color: var(--c-text);
}

.btn--ghost:hover {
  border-color: var(--c-primary);
  color: var(--c-primary);
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(0, 212, 255, 0.14);
}

.btn--sm {
  padding: 10px 22px;
  font-size: 0.86rem;
}

.btn--lg {
  padding: 17px 38px;
  font-size: 1.02rem;
}

/* Cards genéricos */
.card {
  background: var(--c-surface);
  border: 1px solid var(--c-border);
  border-radius: var(--radius-lg);
  padding: 34px 30px;
  position: relative;
  overflow: hidden;
  transition: transform var(--t-med), border-color var(--t-med),
              box-shadow var(--t-med), background var(--t-med);
}

.card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.06), transparent 55%);
  opacity: 0;
  transition: opacity var(--t-med);
  pointer-events: none;
}

.card:hover {
  transform: translateY(-8px);
  border-color: var(--c-border-strong);
  box-shadow: var(--shadow-lg);
}

.card:hover::before {
  opacity: 1;
}

/* Revelação no scroll */
.reveal {
  opacity: 0;
  transform: translateY(38px);
  transition: opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
              transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: opacity, transform;
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.reveal--left  { transform: translateX(-46px); }
.reveal--right { transform: translateX(46px); }
.reveal--zoom  { transform: scale(0.92); }

.reveal--left.is-visible,
.reveal--right.is-visible,
.reveal--zoom.is-visible {
  transform: none;
}

/* Atrasos escalonados */
.d-1 { transition-delay: 0.08s; }
.d-2 { transition-delay: 0.16s; }
.d-3 { transition-delay: 0.24s; }
.d-4 { transition-delay: 0.32s; }
.d-5 { transition-delay: 0.40s; }
.d-6 { transition-delay: 0.48s; }
.d-7 { transition-delay: 0.56s; }
.d-8 { transition-delay: 0.64s; }

/* ==========================================================================
   3. PRELOADER
   ========================================================================== */
#preloader {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 26px;
  background: var(--c-bg);
  transition: opacity 0.7s ease, visibility 0.7s ease;
}

#preloader.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.loader-orb {
  width: 92px;
  height: 92px;
  position: relative;
  display: grid;
  place-items: center;
}

.loader-orb::before,
.loader-orb::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2px solid transparent;
}

.loader-orb::before {
  border-top-color: var(--c-primary);
  border-right-color: var(--c-primary);
  animation: spin 1.1s linear infinite;
}

.loader-orb::after {
  inset: 14px;
  border-bottom-color: var(--c-secondary);
  border-left-color: var(--c-secondary);
  animation: spin 1.6s linear infinite reverse;
}

.loader-core {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--grad-primary);
  box-shadow: 0 0 34px var(--c-primary-glow);
  animation: corePulse 1.3s ease-in-out infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes corePulse {
  0%, 100% { transform: scale(1);   opacity: 1; }
  50%      { transform: scale(0.7); opacity: 0.55; }
}

.loader-text {
  font-family: var(--f-mono);
  font-size: 13px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--c-text-muted);
}

.loader-bar {
  width: 210px;
  height: 3px;
  border-radius: 3px;
  background: var(--c-surface-2);
  overflow: hidden;
}

.loader-bar span {
  display: block;
  height: 100%;
  width: 0%;
  background: var(--grad-primary);
  border-radius: 3px;
  transition: width 0.25s ease;
}

/* ==========================================================================
   4. BARRA DE PROGRESSO + CURSOR
   ========================================================================== */
#scroll-progress {
  position: fixed;
  top: 0;
  left: 0;
  height: 3px;
  width: 0%;
  background: var(--grad-primary);
  z-index: 9998;
  box-shadow: 0 0 14px var(--c-primary-glow);
  transition: width 0.1s linear;
}

.cursor-dot,
.cursor-ring {
  position: fixed;
  top: 0;
  left: 0;
  pointer-events: none;
  z-index: 9999;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  will-change: transform;
}

.cursor-dot {
  width: 6px;
  height: 6px;
  background: var(--c-primary);
  box-shadow: 0 0 12px var(--c-primary);
}

.cursor-ring {
  width: 36px;
  height: 36px;
  border: 1.5px solid rgba(0, 212, 255, 0.55);
  transition: width 0.22s ease, height 0.22s ease,
              border-color 0.22s ease, background 0.22s ease;
}

.cursor-ring.is-hover {
  width: 58px;
  height: 58px;
  border-color: var(--c-secondary);
  background: rgba(124, 92, 255, 0.10);
}

@media (hover: none), (max-width: 900px) {
  .cursor-dot, .cursor-ring { display: none; }
}

/* ==========================================================================
   5. NAVEGAÇÃO
   ========================================================================== */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--nav-h);
  z-index: 9000;
  display: flex;
  align-items: center;
  transition: background var(--t-med), backdrop-filter var(--t-med),
              box-shadow var(--t-med), height var(--t-med), border-color var(--t-med);
  border-bottom: 1px solid transparent;
}

.navbar.scrolled {
  height: 66px;
  background: rgba(10, 14, 26, 0.82);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  border-bottom-color: var(--c-border);
  box-shadow: 0 10px 34px rgba(0, 0, 0, 0.35);
}

[data-theme="light"] .navbar.scrolled {
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 10px 34px rgba(10, 25, 60, 0.10);
}

.nav-inner {
  width: 100%;
  max-width: var(--container);
  margin-inline: auto;
  padding-inline: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 1.06rem;
  letter-spacing: -0.01em;
  flex-shrink: 0;
}

.brand-mark {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: var(--grad-primary);
  display: grid;
  place-items: center;
  font-family: var(--f-mono);
  font-weight: 700;
  font-size: 0.86rem;
  color: #04121c;
  box-shadow: 0 6px 20px rgba(0, 212, 255, 0.35);
  position: relative;
  overflow: hidden;
}

.brand-mark::after {
  content: '';
  position: absolute;
  inset: -50%;
  background: linear-gradient(115deg, transparent 40%, rgba(255,255,255,0.7) 50%, transparent 60%);
  animation: shineSweep 4.5s ease-in-out infinite;
}

@keyframes shineSweep {
  0%, 70%, 100% { transform: translateX(-130%); }
  85%           { transform: translateX(130%); }
}

.brand-text small {
  display: block;
  font-family: var(--f-mono);
  font-size: 9.5px;
  font-weight: 400;
  letter-spacing: 0.19em;
  text-transform: uppercase;
  color: var(--c-text-muted);
  margin-top: -3px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 4px;
  flex: 1;
  justify-content: center;
}

.nav-links a {
  position: relative;
  font-size: 0.895rem;
  font-weight: 500;
  color: var(--c-text-soft);
  padding: 9px 14px;
  border-radius: var(--radius-pill);
  transition: color var(--t-fast), background var(--t-fast);
  white-space: nowrap;
}

.nav-links a::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 3px;
  width: 0;
  height: 2px;
  border-radius: 2px;
  background: var(--grad-primary);
  transform: translateX(-50%);
  transition: width var(--t-med);
}

.nav-links a:hover {
  color: var(--c-text);
  background: rgba(255, 255, 255, 0.05);
}

.nav-links a:hover::after,
.nav-links a.active::after {
  width: 22px;
}

.nav-links a.active {
  color: var(--c-primary);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.theme-toggle {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  border: 1px solid var(--c-border);
  background: var(--c-surface);
  color: var(--c-text-soft);
  transition: color var(--t-fast), border-color var(--t-fast),
              transform var(--t-fast), background var(--t-fast);
}

.theme-toggle:hover {
  color: var(--c-primary);
  border-color: var(--c-primary);
  transform: rotate(-18deg) scale(1.05);
}

.theme-toggle svg {
  width: 19px;
  height: 19px;
}

.theme-toggle .icon-sun  { display: none; }
.theme-toggle .icon-moon { display: block; }

[data-theme="light"] .theme-toggle .icon-sun  { display: block; }
[data-theme="light"] .theme-toggle .icon-moon { display: none; }

.nav-cta {
  padding: 11px 24px;
  font-size: 0.86rem;
}

.hamburger {
  display: none;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  border: 1px solid var(--c-border);
  background: var(--c-surface);
  place-items: center;
  flex-direction: column;
  gap: 5px;
}

.hamburger span {
  display: block;
  width: 19px;
  height: 2px;
  border-radius: 2px;
  background: var(--c-text);
  transition: transform var(--t-med), opacity var(--t-fast), width var(--t-med);
}

.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; }
.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* Menu mobile */
.mobile-menu {
  position: fixed;
  inset: 0;
  z-index: 8999;
  background: var(--c-bg);
  padding: 110px 28px 40px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-14px);
  transition: opacity var(--t-med), visibility var(--t-med), transform var(--t-med);
  overflow-y: auto;
}

.mobile-menu.open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.mobile-menu a {
  font-family: var(--f-head);
  font-size: 1.18rem;
  font-weight: 600;
  padding: 16px 18px;
  border-radius: var(--radius-md);
  border: 1px solid var(--c-border);
  background: var(--c-surface);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: border-color var(--t-fast), transform var(--t-fast), color var(--t-fast);
}

.mobile-menu a:hover {
  border-color: var(--c-primary);
  color: var(--c-primary);
  transform: translateX(6px);
}

.mobile-menu a span.num {
  font-family: var(--f-mono);
  font-size: 0.78rem;
  color: var(--c-text-muted);
}

/* ==========================================================================
   6. HERO / BANNER
   ========================================================================== */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding-top: calc(var(--nav-h) + 60px);
  padding-bottom: 80px;
  overflow: hidden;
  background: var(--c-bg);
}

.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero-bg::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--grad-hero);
  z-index: 2;
}

.hero-bg img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.30;
  filter: saturate(0.65) contrast(1.08);
  transform: scale(1.06);
  animation: heroKenBurns 26s ease-in-out infinite alternate;
}

[data-theme="light"] .hero-bg img {
  opacity: 0.16;
}

@keyframes heroKenBurns {
  0%   { transform: scale(1.06) translate(0, 0); }
  100% { transform: scale(1.16) translate(-2%, -2%); }
}

.hero-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 3;
  background: linear-gradient(180deg,
    rgba(10, 14, 26, 0.55) 0%,
    rgba(10, 14, 26, 0.72) 55%,
    var(--c-bg) 100%);
}

[data-theme="light"] .hero-bg::after {
  background: linear-gradient(180deg,
    rgba(244, 247, 252, 0.55) 0%,
    rgba(244, 247, 252, 0.80) 55%,
    var(--c-bg) 100%);
}

#hero-canvas {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  opacity: 0.75;
}

.hero-inner {
  position: relative;
  z-index: 5;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 60px;
  align-items: center;
  width: 100%;
}

.hero-content {
  max-width: 660px;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: var(--f-mono);
  font-size: 12px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--c-primary);
  background: rgba(0, 212, 255, 0.09);
  border: 1px solid rgba(0, 212, 255, 0.24);
  padding: 8px 18px;
  border-radius: var(--radius-pill);
  margin-bottom: 28px;
  backdrop-filter: blur(8px);
}

.hero-badge .dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--c-success);
  box-shadow: 0 0 10px var(--c-success);
  animation: pulseDot 1.8s ease-in-out infinite;
}

.hero-title {
  font-family: var(--f-head);
  font-size: clamp(2.3rem, 5.4vw, 4.15rem);
  font-weight: 700;
  line-height: 1.06;
  letter-spacing: -0.032em;
  margin-bottom: 26px;
}

.hero-title .line {
  display: block;
  overflow: hidden;
}

.hero-title .line > span {
  display: inline-block;
  animation: riseIn 0.95s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.hero-title .line:nth-child(1) > span { animation-delay: 0.10s; }
.hero-title .line:nth-child(2) > span { animation-delay: 0.22s; }
.hero-title .line:nth-child(3) > span { animation-delay: 0.34s; }

@keyframes riseIn {
  from { transform: translateY(110%); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}

.hero-typing {
  display: block;
  min-height: 1.2em;
  font-family: var(--f-mono);
  font-size: clamp(0.95rem, 1.9vw, 1.22rem);
  font-weight: 500;
  color: var(--c-primary);
  letter-spacing: 0.02em;
  margin-bottom: 24px;
}

.hero-typing .caret {
  display: inline-block;
  width: 2px;
  height: 1.05em;
  background: var(--c-primary);
  vertical-align: -0.15em;
  margin-left: 3px;
  animation: caretBlink 1s steps(2) infinite;
}

@keyframes caretBlink {
  0%, 49%   { opacity: 1; }
  50%, 100% { opacity: 0; }
}

.hero-desc {
  font-size: 1.075rem;
  color: var(--c-text-soft);
  line-height: 1.82;
  margin-bottom: 38px;
  max-width: 570px;
  animation: riseIn 0.95s cubic-bezier(0.22, 1, 0.36, 1) 0.46s both;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 52px;
  animation: riseIn 0.95s cubic-bezier(0.22, 1, 0.36, 1) 0.58s both;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  max-width: 560px;
  animation: riseIn 0.95s cubic-bezier(0.22, 1, 0.36, 1) 0.70s both;
}

.hero-stat {
  background: rgba(22, 32, 58, 0.62);
  backdrop-filter: blur(14px);
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  padding: 18px 16px;
  transition: border-color var(--t-med), transform var(--t-med), box-shadow var(--t-med);
}

[data-theme="light"] .hero-stat {
  background: rgba(255, 255, 255, 0.78);
}

.hero-stat:hover {
  border-color: var(--c-primary);
  transform: translateY(-5px);
  box-shadow: 0 14px 34px rgba(0, 212, 255, 0.16);
}

.hero-stat .num {
  font-family: var(--f-head);
  font-size: 1.72rem;
  font-weight: 700;
  line-height: 1.1;
  background: var(--grad-primary);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-stat .lbl {
  display: block;
  font-size: 0.775rem;
  color: var(--c-text-muted);
  line-height: 1.45;
  margin-top: 5px;
}

/* Card flutuante do hero */
.hero-visual {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: riseIn 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.62s both;
}

.hero-orb {
  position: relative;
  width: 100%;
  max-width: 420px;
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  display: grid;
  place-items: center;
}

.hero-orb::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 1px dashed rgba(0, 212, 255, 0.28);
  animation: spin 34s linear infinite;
}

.hero-orb::after {
  content: '';
  position: absolute;
  inset: 34px;
  border-radius: 50%;
  border: 1px solid rgba(124, 92, 255, 0.30);
  animation: spin 24s linear infinite reverse;
}

.orb-core {
  width: 66%;
  height: 66%;
  border-radius: 50%;
  overflow: hidden;
  border: 1px solid var(--c-border-strong);
  box-shadow: 0 0 70px rgba(0, 212, 255, 0.28),
              inset 0 0 60px rgba(124, 92, 255, 0.22);
  position: relative;
}

.orb-core img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  animation: heroKenBurns 20s ease-in-out infinite alternate;
}

.orb-core::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, rgba(0, 212, 255, 0.22), rgba(124, 92, 255, 0.30));
  mix-blend-mode: screen;
}

.orbit-chip {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 15px;
  font-family: var(--f-mono);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.04em;
  border-radius: var(--radius-pill);
  background: rgba(22, 32, 58, 0.92);
  border: 1px solid var(--c-border-strong);
  box-shadow: var(--shadow-md);
  backdrop-filter: blur(10px);
  white-space: nowrap;
  animation: floatChip 5.5s ease-in-out infinite;
}

[data-theme="light"] .orbit-chip {
  background: rgba(255, 255, 255, 0.94);
}

.orbit-chip i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  display: block;
}

.orbit-chip.c1 { top: 8%;  left: -4%;  animation-delay: 0s;   }
.orbit-chip.c2 { top: 30%; right: -8%; animation-delay: 0.9s; }
.orbit-chip.c3 { bottom: 24%; left: -8%; animation-delay: 1.8s; }
.orbit-chip.c4 { bottom: 6%; right: 2%; animation-delay: 2.6s; }

.orbit-chip.c1 i { background: var(--c-success); box-shadow: 0 0 10px var(--c-success); }
.orbit-chip.c2 i { background: var(--c-primary); box-shadow: 0 0 10px var(--c-primary); }
.orbit-chip.c3 i { background: var(--c-warning); box-shadow: 0 0 10px var(--c-warning); }
.orbit-chip.c4 i { background: var(--c-accent);  box-shadow: 0 0 10px var(--c-accent); }

@keyframes floatChip {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-13px); }
}

/* Indicador de scroll */
.scroll-hint {
  position: absolute;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 6;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9px;
  font-family: var(--f-mono);
  font-size: 10.5px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--c-text-muted);
  animation: fadeInUp 1.4s ease 1.4s both;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translate(-50%, 16px); }
  to   { opacity: 1; transform: translate(-50%, 0); }
}

.scroll-mouse {
  width: 24px;
  height: 38px;
  border: 1.5px solid var(--c-border-strong);
  border-radius: var(--radius-pill);
  position: relative;
}

.scroll-mouse::after {
  content: '';
  position: absolute;
  top: 7px;
  left: 50%;
  width: 3px;
  height: 8px;
  border-radius: 3px;
  background: var(--c-primary);
  transform: translateX(-50%);
  animation: mouseWheel 1.8s ease-in-out infinite;
}

@keyframes mouseWheel {
  0%   { opacity: 0; transform: translate(-50%, 0); }
  35%  { opacity: 1; }
  100% { opacity: 0; transform: translate(-50%, 14px); }
}

/* ==========================================================================
   7. TICKER / MARQUEE
   ========================================================================== */
.ticker {
  position: relative;
  overflow: hidden;
  border-block: 1px solid var(--c-border);
  background: var(--c-bg-alt);
  padding-block: 20px;
  display: flex;
  user-select: none;
}

.ticker::before,
.ticker::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 140px;
  z-index: 2;
  pointer-events: none;
}

.ticker::before {
  left: 0;
  background: linear-gradient(90deg, var(--c-bg-alt), transparent);
}

.ticker::after {
  right: 0;
  background: linear-gradient(270deg, var(--c-bg-alt), transparent);
}

.ticker-track {
  display: flex;
  gap: 54px;
  animation: tickerScroll 34s linear infinite;
  flex-shrink: 0;
  padding-right: 54px;
}

.ticker:hover .ticker-track {
  animation-play-state: paused;
}

@keyframes tickerScroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

.ticker-item {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--f-mono);
  font-size: 0.83rem;
  font-weight: 500;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--c-text-muted);
  white-space: nowrap;
}

.ticker-item svg {
  width: 15px;
  height: 15px;
  color: var(--c-primary);
  flex-shrink: 0;
}

.ticker-item strong {
  color: var(--c-text);
  font-weight: 600;
}

/* ==========================================================================
   8. SEÇÃO: O QUE É IA
   ========================================================================== */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}

.about-visual {
  position: relative;
}

.about-img-wrap {
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 1px solid var(--c-border-strong);
  box-shadow: var(--shadow-lg);
  aspect-ratio: 4 / 4.4;
}

.about-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.about-img-wrap:hover img {
  transform: scale(1.07);
}

.about-img-wrap::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 45%, rgba(10, 14, 26, 0.86) 100%);
}

.about-img-caption {
  position: absolute;
  bottom: 26px;
  left: 26px;
  right: 26px;
  z-index: 2;
}

.about-img-caption h4 {
  font-family: var(--f-head);
  font-size: 1.06rem;
  font-weight: 600;
  color: #eaf0ff;
  margin-bottom: 4px;
}

.about-img-caption p {
  font-size: 0.83rem;
  color: rgba(234, 240, 255, 0.66);
  line-height: 1.5;
}

.about-float-card {
  position: absolute;
  right: -22px;
  top: 42px;
  background: var(--c-surface);
  border: 1px solid var(--c-border-strong);
  border-radius: var(--radius-md);
  padding: 18px 22px;
  box-shadow: var(--shadow-lg);
  display: flex;
  align-items: center;
  gap: 14px;
  animation: floatChip 6s ease-in-out infinite;
  z-index: 3;
}

.about-float-card .ic {
  width: 40px;
  height: 40px;
  border-radius: 11px;
  background: var(--grad-primary);
  display: grid;
  place-items: center;
  color: #04121c;
  flex-shrink: 0;
}

.about-float-card .ic svg { width: 20px; height: 20px; }

.about-float-card strong {
  display: block;
  font-family: var(--f-head);
  font-size: 1.16rem;
  font-weight: 700;
  line-height: 1.1;
}

.about-float-card span {
  font-size: 0.74rem;
  color: var(--c-text-muted);
}

.about-text p {
  color: var(--c-text-soft);
  margin-bottom: 20px;
  line-height: 1.86;
}

.about-text p strong {
  color: var(--c-text);
  font-weight: 600;
}

.about-callout {
  margin-top: 30px;
  padding: 22px 26px;
  border-left: 3px solid var(--c-primary);
  background: rgba(0, 212, 255, 0.06);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  font-size: 0.95rem;
  color: var(--c-text-soft);
  line-height: 1.78;
}

.about-callout strong { color: var(--c-primary); }

.mini-features {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  margin-top: 32px;
}

.mini-feature {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 16px;
  border-radius: var(--radius-md);
  background: var(--c-surface);
  border: 1px solid var(--c-border);
  transition: border-color var(--t-med), transform var(--t-med);
}

.mini-feature:hover {
  border-color: var(--c-primary);
  transform: translateY(-4px);
}

.mini-feature svg {
  width: 19px;
  height: 19px;
  color: var(--c-primary);
  flex-shrink: 0;
  margin-top: 3px;
}

.mini-feature b {
  display: block;
  font-family: var(--f-head);
  font-size: 0.9rem;
  font-weight: 600;
  margin-bottom: 2px;
}

.mini-feature span {
  font-size: 0.79rem;
  color: var(--c-text-muted);
  line-height: 1.5;
}

/* ==========================================================================
   9. SEÇÃO: COMO FUNCIONA (PASSOS)
   ========================================================================== */
.steps-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26px;
  position: relative;
}

.steps-grid::before {
  content: '';
  position: absolute;
  top: 62px;
  left: 16%;
  right: 16%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--c-border-strong), transparent);
  z-index: 0;
}

.step-card {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 40px 28px 34px;
}

.step-num {
  width: 62px;
  height: 62px;
  margin: 0 auto 22px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-family: var(--f-head);
  font-size: 1.22rem;
  font-weight: 700;
  background: var(--c-bg-alt);
  border: 1px solid var(--c-border-strong);
  color: var(--c-primary);
  position: relative;
  transition: background var(--t-med), color var(--t-med), transform var(--t-med);
}

.step-card:hover .step-num {
  background: var(--grad-primary);
  color: #04121c;
  transform: scale(1.08) rotate(-6deg);
}

.step-card h3 {
  font-family: var(--f-head);
  font-size: 1.16rem;
  font-weight: 600;
  margin-bottom: 12px;
}

.step-card p {
  font-size: 0.92rem;
  color: var(--c-text-soft);
  line-height: 1.76;
}

/* Abas interativas */
.tabs {
  margin-top: 56px;
}

.tab-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
  margin-bottom: 34px;
}

.tab-btn {
  padding: 11px 24px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--c-border);
  background: var(--c-surface);
  color: var(--c-text-soft);
  font-size: 0.88rem;
  font-weight: 500;
  transition: all var(--t-fast);
}

.tab-btn:hover {
  border-color: var(--c-primary);
  color: var(--c-primary);
}

.tab-btn.active {
  background: var(--grad-primary);
  border-color: transparent;
  color: #04121c;
  font-weight: 600;
  box-shadow: 0 8px 24px rgba(0, 212, 255, 0.28);
}

.tab-panel {
  display: none;
  animation: fadeSlide 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

.tab-panel.active {
  display: block;
}

@keyframes fadeSlide {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

.tab-panel-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 44px;
  align-items: center;
  background: var(--c-surface);
  border: 1px solid var(--c-border);
  border-radius: var(--radius-xl);
  padding: 44px;
}

.tab-panel-inner img {
  border-radius: var(--radius-lg);
  aspect-ratio: 16 / 11;
  object-fit: cover;
  width: 100%;
  border: 1px solid var(--c-border);
}

.tab-panel-inner h3 {
  font-family: var(--f-head);
  font-size: 1.5rem;
  font-weight: 600;
  margin-bottom: 14px;
}

.tab-panel-inner p {
  color: var(--c-text-soft);
  font-size: 0.96rem;
  line-height: 1.82;
  margin-bottom: 20px;
}

.tab-list li {
  display: flex;
  gap: 11px;
  align-items: flex-start;
  font-size: 0.9rem;
  color: var(--c-text-soft);
  padding: 8px 0;
  line-height: 1.62;
}

.tab-list li svg {
  width: 17px;
  height: 17px;
  color: var(--c-success);
  flex-shrink: 0;
  margin-top: 3px;
}

/* ==========================================================================
   10. SEÇÃO: OPORTUNIDADES
   ========================================================================== */
.opp-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.opp-card {
  padding: 36px 30px;
}

.opp-card .icon-box {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  margin-bottom: 22px;
  background: rgba(0, 212, 255, 0.10);
  border: 1px solid rgba(0, 212, 255, 0.24);
  color: var(--c-primary);
  transition: transform var(--t-med), background var(--t-med), color var(--t-med);
}

.opp-card:hover .icon-box {
  transform: rotate(-8deg) scale(1.08);
  background: var(--grad-primary);
  color: #04121c;
  border-color: transparent;
}

.opp-card .icon-box svg {
  width: 26px;
  height: 26px;
}

.opp-card h3 {
  font-family: var(--f-head);
  font-size: 1.12rem;
  font-weight: 600;
  margin-bottom: 11px;
}

.opp-card p {
  font-size: 0.91rem;
  color: var(--c-text-soft);
  line-height: 1.78;
}

.opp-tag {
  display: inline-block;
  margin-top: 18px;
  font-family: var(--f-mono);
  font-size: 0.71rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--c-success);
  background: rgba(44, 224, 138, 0.10);
  border: 1px solid rgba(44, 224, 138, 0.24);
  padding: 5px 12px;
  border-radius: var(--radius-pill);
}

/* Faixa com imagem */
.split-banner {
  margin-top: 60px;
  border-radius: var(--radius-xl);
  overflow: hidden;
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  border: 1px solid var(--c-border-strong);
  background: var(--c-surface);
}

.split-banner img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  min-height: 340px;
}

.split-banner-content {
  padding: 54px 48px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.split-banner-content h3 {
  font-family: var(--f-head);
  font-size: 1.68rem;
  font-weight: 600;
  line-height: 1.24;
  margin-bottom: 16px;
}

.split-banner-content p {
  color: var(--c-text-soft);
  font-size: 0.96rem;
  line-height: 1.82;
  margin-bottom: 24px;
}

/* ==========================================================================
   11. SEÇÃO: AMEAÇAS
   ========================================================================== */
.threat-section {
  position: relative;
  overflow: hidden;
}

.threat-section::before {
  content: '';
  position: absolute;
  top: -20%;
  right: -10%;
  width: 620px;
  height: 620px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 82, 82, 0.10), transparent 68%);
  pointer-events: none;
}

.threat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.threat-card {
  display: flex;
  gap: 22px;
  padding: 32px 30px;
  border-left: 3px solid transparent;
  transition: border-color var(--t-med), transform var(--t-med),
              background var(--t-med), box-shadow var(--t-med);
}

.threat-card:hover {
  border-left-color: var(--c-danger);
  transform: translateX(6px);
  background: var(--c-surface-2);
  box-shadow: var(--shadow-md);
}

.threat-card .t-ic {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  border-radius: 13px;
  display: grid;
  place-items: center;
  background: rgba(255, 82, 82, 0.10);
  border: 1px solid rgba(255, 82, 82, 0.24);
  color: var(--c-danger);
}

.threat-card .t-ic svg {
  width: 22px;
  height: 22px;
}

.threat-card h3 {
  font-family: var(--f-head);
  font-size: 1.06rem;
  font-weight: 600;
  margin-bottom: 9px;
}

.threat-card p {
  font-size: 0.90rem;
  color: var(--c-text-soft);
  line-height: 1.76;
}

/* Gráfico */
.chart-wrap {
  margin-top: 60px;
  background: var(--c-surface);
  border: 1px solid var(--c-border);
  border-radius: var(--radius-xl);
  padding: 40px;
}

.chart-header {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16px;
  margin-bottom: 30px;
}

.chart-header h3 {
  font-family: var(--f-head);
  font-size: 1.22rem;
  font-weight: 600;
  margin-bottom: 4px;
}

.chart-header p {
  font-size: 0.83rem;
  color: var(--c-text-muted);
}

.chart-legend {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.chart-legend span {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8rem;
  color: var(--c-text-soft);
}

.chart-legend i {
  width: 11px;
  height: 11px;
  border-radius: 3px;
  display: block;
}

.chart-canvas-box {
  position: relative;
  width: 100%;
  height: 320px;
}

.chart-canvas-box canvas {
  width: 100% !important;
  height: 100% !important;
}

/* ==========================================================================
   12. COMPARATIVO
   ========================================================================== */
.compare-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 0;
  align-items: stretch;
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 1px solid var(--c-border-strong);
}

.compare-col {
  padding: 46px 40px;
  background: var(--c-surface);
}

.compare-col.pros {
  background: linear-gradient(160deg, rgba(44, 224, 138, 0.09), var(--c-surface) 62%);
}

.compare-col.cons {
  background: linear-gradient(160deg, rgba(255, 82, 82, 0.09), var(--c-surface) 62%);
}

.compare-col h3 {
  font-family: var(--f-head);
  font-size: 1.34rem;
  font-weight: 700;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.compare-col h3 .badge {
  width: 38px;
  height: 38px;
  border-radius: 11px;
  display: grid;
  place-items: center;
}

.compare-col.pros h3 .badge {
  background: rgba(44, 224, 138, 0.14);
  border: 1px solid rgba(44, 224, 138, 0.30);
  color: var(--c-success);
}

.compare-col.cons h3 .badge {
  background: rgba(255, 82, 82, 0.14);
  border: 1px solid rgba(255, 82, 82, 0.30);
  color: var(--c-danger);
}

.compare-col h3 .badge svg { width: 20px; height: 20px; }

.compare-col > p {
  font-size: 0.86rem;
  color: var(--c-text-muted);
  margin-bottom: 26px;
}

.compare-col ul li {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 13px 0;
  border-bottom: 1px solid var(--c-border);
  font-size: 0.91rem;
  color: var(--c-text-soft);
  line-height: 1.66;
}

.compare-col ul li:last-child {
  border-bottom: none;
}

.compare-col ul li svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  margin-top: 2px;
}

.compare-col.pros ul li svg { color: var(--c-success); }
.compare-col.cons ul li svg { color: var(--c-danger); }

.compare-vs {
  display: grid;
  place-items: center;
  padding: 0 22px;
  background: var(--c-bg-alt);
  position: relative;
}

.compare-vs span {
  font-family: var(--f-head);
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: var(--grad-primary);
  color: #04121c;
  box-shadow: 0 0 40px rgba(0, 212, 255, 0.30);
}

/* ==========================================================================
   13. PROFISSIONAL DO FUTURO
   ========================================================================== */
.skills-layout {
  display: grid;
  grid-template-columns: 0.95fr 1.05fr;
  gap: 64px;
  align-items: center;
}

.skills-visual {
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 1px solid var(--c-border-strong);
  box-shadow: var(--shadow-lg);
  aspect-ratio: 3 / 3.5;
}

.skills-visual img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.skills-visual:hover img {
  transform: scale(1.06);
}

.skills-visual::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(10, 14, 26, 0.90) 100%);
}

.skills-badge {
  position: absolute;
  bottom: 28px;
  left: 28px;
  right: 28px;
  z-index: 2;
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.skills-badge span {
  font-family: var(--f-mono);
  font-size: 0.73rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  padding: 7px 14px;
  border-radius: var(--radius-pill);
  background: rgba(0, 212, 255, 0.16);
  border: 1px solid rgba(0, 212, 255, 0.34);
  color: #bfeaff;
  backdrop-filter: blur(8px);
}

.skill-bars {
  display: flex;
  flex-direction: column;
  gap: 26px;
  margin-top: 34px;
}

.skill-bar-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10px;
}

.skill-bar-head b {
  font-family: var(--f-head);
  font-size: 0.95rem;
  font-weight: 600;
}

.skill-bar-head span {
  font-family: var(--f-mono);
  font-size: 0.82rem;
  color: var(--c-primary);
  font-weight: 500;
}

.skill-track {
  height: 9px;
  border-radius: var(--radius-pill);
  background: var(--c-surface-2);
  overflow: hidden;
  position: relative;
}

.skill-fill {
  height: 100%;
  width: 0;
  border-radius: var(--radius-pill);
  background: var(--grad-primary);
  transition: width 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
}

.skill-fill::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.42), transparent);
  animation: shimmer 2.4s linear infinite;
}

@keyframes shimmer {
  from { transform: translateX(-100%); }
  to   { transform: translateX(100%); }
}

.skill-fill.warm  { background: var(--grad-secondary); }
.skill-fill.green { background: var(--grad-success); }

/* Cards de competências */
.skills-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-top: 68px;
}

.skill-card {
  text-align: center;
  padding: 30px 20px;
}

.skill-card .s-ic {
  width: 52px;
  height: 52px;
  margin: 0 auto 16px;
  border-radius: 15px;
  display: grid;
  place-items: center;
  background: var(--c-bg-alt);
  border: 1px solid var(--c-border);
  color: var(--c-primary);
  transition: all var(--t-med);
}

.skill-card:hover .s-ic {
  background: var(--grad-primary);
  color: #04121c;
  transform: translateY(-5px) rotate(6deg);
  border-color: transparent;
}

.skill-card .s-ic svg { width: 24px; height: 24px; }

.skill-card h4 {
  font-family: var(--f-head);
  font-size: 0.96rem;
  font-weight: 600;
  margin-bottom: 7px;
}

.skill-card p {
  font-size: 0.79rem;
  color: var(--c-text-muted);
  line-height: 1.6;
}

/* ==========================================================================
   14. TIMELINE
   ========================================================================== */
.timeline {
  position: relative;
  max-width: 900px;
  margin-inline: auto;
  padding-left: 46px;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 15px;
  top: 8px;
  bottom: 8px;
  width: 2px;
  background: linear-gradient(180deg,
    var(--c-primary) 0%,
    var(--c-secondary) 50%,
    var(--c-accent) 100%);
  opacity: 0.42;
  border-radius: 2px;
}

.tl-item {
  position: relative;
  padding-bottom: 46px;
}

.tl-item:last-child {
  padding-bottom: 0;
}

.tl-item::before {
  content: '';
  position: absolute;
  left: -38px;
  top: 6px;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  background: var(--c-bg);
  border: 2.5px solid var(--c-primary);
  box-shadow: 0 0 0 5px rgba(0, 212, 255, 0.10);
  transition: transform var(--t-med), box-shadow var(--t-med);
}

.tl-item:hover::before {
  transform: scale(1.28);
  box-shadow: 0 0 0 9px rgba(0, 212, 255, 0.16);
}

.tl-year {
  display: inline-block;
  font-family: var(--f-mono);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--c-primary);
  background: rgba(0, 212, 255, 0.10);
  border: 1px solid rgba(0, 212, 255, 0.24);
  padding: 4px 13px;
  border-radius: var(--radius-pill);
  margin-bottom: 11px;
}

.tl-item h4 {
  font-family: var(--f-head);
  font-size: 1.13rem;
  font-weight: 600;
  margin-bottom: 8px;
}

.tl-item p {
  font-size: 0.91rem;
  color: var(--c-text-soft);
  line-height: 1.76;
}

/* ==========================================================================
   15. SETORES
   ========================================================================== */
.sector-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.sector-card {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--c-border);
  aspect-ratio: 3 / 4;
  cursor: pointer;
  transition: transform var(--t-med), box-shadow var(--t-med), border-color var(--t-med);
}

.sector-card:hover {
  transform: translateY(-9px);
  box-shadow: var(--shadow-lg);
  border-color: var(--c-primary);
}

.sector-card img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1);
}

.sector-card:hover img {
  transform: scale(1.10);
}

.sector-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg,
    rgba(10, 14, 26, 0.10) 0%,
    rgba(10, 14, 26, 0.62) 52%,
    rgba(10, 14, 26, 0.95) 100%);
}

.sector-body {
  position: absolute;
  inset: auto 0 0 0;
  padding: 26px 22px;
  z-index: 2;
}

.sector-body .sector-ic {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: rgba(0, 212, 255, 0.18);
  border: 1px solid rgba(0, 212, 255, 0.36);
  color: #9fe6ff;
  margin-bottom: 13px;
  backdrop-filter: blur(8px);
  transition: background var(--t-med), color var(--t-med);
}

.sector-card:hover .sector-ic {
  background: var(--grad-primary);
  color: #04121c;
}

.sector-body .sector-ic svg { width: 21px; height: 21px; }

.sector-body h4 {
  font-family: var(--f-head);
  font-size: 1.06rem;
  font-weight: 600;
  color: #eaf0ff;
  margin-bottom: 7px;
}

.sector-body p {
  font-size: 0.82rem;
  color: rgba(234, 240, 255, 0.74);
  line-height: 1.62;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height var(--t-slow), opacity var(--t-med), margin var(--t-med);
}

.sector-card:hover .sector-body p {
  max-height: 120px;
  opacity: 1;
  margin-top: 4px;
}

/* ==========================================================================
   16. RESPONSABILIDADES
   ========================================================================== */
.resp-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26px;
}

.resp-card {
  overflow: hidden;
  padding: 0;
}

.resp-img {
  height: 190px;
  overflow: hidden;
  position: relative;
}

.resp-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1);
}

.resp-card:hover .resp-img img {
  transform: scale(1.09);
}

.resp-img::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 30%, var(--c-surface) 100%);
}

.resp-body {
  padding: 0 30px 34px;
  position: relative;
  margin-top: -30px;
  z-index: 2;
}

.resp-badge {
  width: 54px;
  height: 54px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  background: var(--grad-primary);
  color: #04121c;
  margin-bottom: 18px;
  box-shadow: 0 10px 28px rgba(0, 212, 255, 0.30);
}

.resp-badge svg { width: 25px; height: 25px; }

.resp-body h3 {
  font-family: var(--f-head);
  font-size: 1.16rem;
  font-weight: 600;
  margin-bottom: 11px;
}

.resp-body p {
  font-size: 0.90rem;
  color: var(--c-text-soft);
  line-height: 1.78;
  margin-bottom: 18px;
}

.resp-list li {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  font-size: 0.85rem;
  color: var(--c-text-muted);
  padding: 6px 0;
  line-height: 1.6;
}

.resp-list li svg {
  width: 15px;
  height: 15px;
  color: var(--c-primary);
  flex-shrink: 0;
  margin-top: 3px;
}

/* ==========================================================================
   17. ESTATÍSTICAS / NÚMEROS
   ========================================================================== */
.stats-band {
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.08), rgba(124, 92, 255, 0.08));
  border-block: 1px solid var(--c-border);
  padding-block: 80px;
  position: relative;
  overflow: hidden;
}

.stats-band::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
  background-size: 54px 54px;
  mask-image: radial-gradient(ellipse at center, black, transparent 78%);
  -webkit-mask-image: radial-gradient(ellipse at center, black, transparent 78%);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  position: relative;
  z-index: 1;
}

.stat-block {
  text-align: center;
  padding: 26px 16px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--c-border);
  background: rgba(22, 32, 58, 0.42);
  backdrop-filter: blur(10px);
  transition: transform var(--t-med), border-color var(--t-med), box-shadow var(--t-med);
}

[data-theme="light"] .stat-block {
  background: rgba(255, 255, 255, 0.72);
}

.stat-block:hover {
  transform: translateY(-7px);
  border-color: var(--c-primary);
  box-shadow: 0 16px 40px rgba(0, 212, 255, 0.16);
}

.stat-num {
  font-family: var(--f-head);
  font-size: clamp(2rem, 4vw, 2.9rem);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.03em;
  background: var(--grad-primary);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 9px;
}

.stat-num sup {
  font-size: 0.5em;
  vertical-align: super;
}

.stat-lbl {
  font-size: 0.855rem;
  color: var(--c-text-soft);
  line-height: 1.55;
}

.stat-src {
  display: block;
  font-family: var(--f-mono);
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  color: var(--c-text-muted);
  margin-top: 8px;
  text-transform: uppercase;
}

/* ==========================================================================
   18. QUIZ
   ========================================================================== */
.quiz-box {
  max-width: 820px;
  margin-inline: auto;
  background: var(--c-surface);
  border: 1px solid var(--c-border-strong);
  border-radius: var(--radius-xl);
  padding: 48px;
  box-shadow: var(--shadow-lg);
  position: relative;
  overflow: hidden;
}

.quiz-box::before {
  content: '';
  position: absolute;
  top: -120px;
  right: -120px;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 92, 255, 0.18), transparent 68%);
  pointer-events: none;
}

.quiz-progress {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 30px;
  position: relative;
  z-index: 1;
}

.quiz-progress-track {
  flex: 1;
  height: 7px;
  border-radius: var(--radius-pill);
  background: var(--c-surface-2);
  overflow: hidden;
}

.quiz-progress-fill {
  height: 100%;
  width: 0;
  border-radius: var(--radius-pill);
  background: var(--grad-primary);
  transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.quiz-progress-label {
  font-family: var(--f-mono);
  font-size: 0.8rem;
  color: var(--c-text-muted);
  white-space: nowrap;
}

.quiz-question {
  font-family: var(--f-head);
  font-size: 1.24rem;
  font-weight: 600;
  line-height: 1.42;
  margin-bottom: 28px;
  position: relative;
  z-index: 1;
  min-height: 58px;
}

.quiz-options {
  display: flex;
  flex-direction: column;
  gap: 12px;
  position: relative;
  z-index: 1;
}

.quiz-option {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 20px;
  border-radius: var(--radius-md);
  border: 1px solid var(--c-border);
  background: var(--c-bg-alt);
  font-size: 0.94rem;
  text-align: left;
  color: var(--c-text-soft);
  transition: all var(--t-fast);
  line-height: 1.5;
}

.quiz-option:hover:not(:disabled) {
  border-color: var(--c-primary);
  background: rgba(0, 212, 255, 0.07);
  color: var(--c-text);
  transform: translateX(5px);
}

.quiz-option .letter {
  width: 30px;
  height: 30px;
  border-radius: 9px;
  display: grid;
  place-items: center;
  font-family: var(--f-mono);
  font-size: 0.8rem;
  font-weight: 700;
  background: var(--c-surface-2);
  color: var(--c-text-muted);
  flex-shrink: 0;
  transition: all var(--t-fast);
}

.quiz-option:hover:not(:disabled) .letter {
  background: var(--grad-primary);
  color: #04121c;
}

.quiz-option.correct {
  border-color: var(--c-success);
  background: rgba(44, 224, 138, 0.10);
  color: var(--c-text);
}

.quiz-option.correct .letter {
  background: var(--c-success);
  color: #04121c;
}

.quiz-option.wrong {
  border-color: var(--c-danger);
  background: rgba(255, 82, 82, 0.10);
  color: var(--c-text);
}

.quiz-option.wrong .letter {
  background: var(--c-danger);
  color: #fff;
}

.quiz-option:disabled {
  cursor: default;
}

.quiz-footer {
  margin-top: 26px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  position: relative;
  z-index: 1;
}

.quiz-feedback {
  font-size: 0.88rem;
  color: var(--c-text-soft);
  line-height: 1.6;
  flex: 1;
}

.quiz-result {
  text-align: center;
  padding: 20px 0;
  position: relative;
  z-index: 1;
}

.quiz-result .score-ring {
  width: 160px;
  height: 160px;
  margin: 0 auto 26px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  position: relative;
  background: conic-gradient(var(--c-primary) 0deg, var(--c-surface-2) 0deg);
  transition: background 1s ease;
}

.quiz-result .score-ring::before {
  content: '';
  position: absolute;
  inset: 12px;
  border-radius: 50%;
  background: var(--c-surface);
}

.quiz-result .score-inner {
  position: relative;
  z-index: 1;
  text-align: center;
}

.quiz-result .score-inner b {
  display: block;
  font-family: var(--f-head);
  font-size: 2.1rem;
  font-weight: 700;
  line-height: 1;
  background: var(--grad-primary);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.quiz-result .score-inner span {
  font-size: 0.74rem;
  color: var(--c-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-family: var(--f-mono);
}

.quiz-result h3 {
  font-family: var(--f-head);
  font-size: 1.42rem;
  font-weight: 700;
  margin-bottom: 12px;
}

.quiz-result p {
  color: var(--c-text-soft);
  font-size: 0.96rem;
  line-height: 1.8;
  max-width: 500px;
  margin: 0 auto 26px;
}

/* ==========================================================================
   19. FAQ
   ========================================================================== */
.faq-list {
  max-width: 900px;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.faq-item {
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  background: var(--c-surface);
  overflow: hidden;
  transition: border-color var(--t-med), background var(--t-med);
}

.faq-item.open {
  border-color: var(--c-primary);
  background: var(--c-surface-2);
}

.faq-q {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 22px 26px;
  text-align: left;
  font-family: var(--f-head);
  font-size: 1.01rem;
  font-weight: 600;
  color: var(--c-text);
  transition: color var(--t-fast);
}

.faq-q:hover {
  color: var(--c-primary);
}

.faq-q .faq-icon {
  width: 30px;
  height: 30px;
  border-radius: 9px;
  display: grid;
  place-items: center;
  background: var(--c-bg-alt);
  border: 1px solid var(--c-border);
  flex-shrink: 0;
  transition: all var(--t-med);
  position: relative;
}

.faq-q .faq-icon::before,
.faq-q .faq-icon::after {
  content: '';
  position: absolute;
  background: currentColor;
  border-radius: 2px;
  transition: transform var(--t-med), opacity var(--t-fast);
}

.faq-q .faq-icon::before {
  width: 12px;
  height: 2px;
}

.faq-q .faq-icon::after {
  width: 2px;
  height: 12px;
}

.faq-item.open .faq-icon {
  background: var(--grad-primary);
  color: #04121c;
  border-color: transparent;
  transform: rotate(180deg);
}

.faq-item.open .faq-icon::after {
  transform: scaleY(0);
  opacity: 0;
}

.faq-a {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

.faq-a-inner {
  padding: 0 26px 24px;
  font-size: 0.93rem;
  color: var(--c-text-soft);
  line-height: 1.84;
}

/* ==========================================================================
   20. CONCLUSÃO / CTA
   ========================================================================== */
.cta-section {
  position: relative;
  overflow: hidden;
  padding-block: 120px;
}

.cta-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--grad-hero);
  z-index: 0;
}

.cta-section::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle at 15% 30%, rgba(0,212,255,0.10) 0 1px, transparent 1px),
    radial-gradient(circle at 70% 60%, rgba(124,92,255,0.10) 0 1px, transparent 1px);
  background-size: 90px 90px, 120px 120px;
  z-index: 0;
  opacity: 0.8;
}

.cta-inner {
  position: relative;
  z-index: 2;
  max-width: 880px;
  margin-inline: auto;
  text-align: center;
}

.cta-quote {
  font-family: var(--f-head);
  font-size: clamp(1.4rem, 3.1vw, 2.15rem);
  font-weight: 600;
  line-height: 1.42;
  letter-spacing: -0.018em;
  margin-bottom: 34px;
}

.cta-quote .hl {
  background: var(--grad-primary);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  position: relative;
}

.cta-actions {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}

/* ==========================================================================
   21. FOOTER
   ========================================================================== */
.footer {
  background: var(--c-bg-alt);
  border-top: 1px solid var(--c-border);
  padding-top: 72px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr 1fr;
  gap: 48px;
  padding-bottom: 54px;
}

.footer-brand p {
  font-size: 0.90rem;
  color: var(--c-text-muted);
  line-height: 1.78;
  margin-top: 18px;
  max-width: 320px;
}

.footer-social {
  display: flex;
  gap: 10px;
  margin-top: 24px;
}

.footer-social a {
  width: 40px;
  height: 40px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  border: 1px solid var(--c-border);
  background: var(--c-surface);
  color: var(--c-text-muted);
  transition: all var(--t-fast);
}

.footer-social a:hover {
  color: var(--c-primary);
  border-color: var(--c-primary);
  transform: translateY(-4px);
}

.footer-social a svg { width: 18px; height: 18px; }

.footer-col h5 {
  font-family: var(--f-head);
  font-size: 0.86rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--c-text);
  margin-bottom: 20px;
}

.footer-col ul li {
  margin-bottom: 12px;
}

.footer-col ul li a {
  font-size: 0.89rem;
  color: var(--c-text-muted);
  transition: color var(--t-fast), padding-left var(--t-fast);
  display: inline-block;
}

.footer-col ul li a:hover {
  color: var(--c-primary);
  padding-left: 5px;
}

.footer-bottom {
  border-top: 1px solid var(--c-border);
  padding-block: 26px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.footer-bottom p {
  font-size: 0.83rem;
  color: var(--c-text-muted);
}

.footer-bottom p strong {
  color: var(--c-text-soft);
  font-weight: 600;
}

.footer-bottom .made {
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: var(--f-mono);
  font-size: 0.76rem;
  color: var(--c-text-muted);
}

.footer-bottom .made svg {
  width: 14px;
  height: 14px;
  color: var(--c-accent);
  animation: heartBeat 1.6s ease-in-out infinite;
}

@keyframes heartBeat {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.22); }
}

/* ==========================================================================
   22. BOTÃO VOLTAR AO TOPO
   ========================================================================== */
#back-to-top {
  position: fixed;
  right: 26px;
  bottom: 26px;
  width: 50px;
  height: 50px;
  border-radius: 15px;
  display: grid;
  place-items: center;
  background: var(--grad-primary);
  color: #04121c;
  box-shadow: 0 10px 32px rgba(0, 212, 255, 0.34);
  z-index: 8000;
  opacity: 0;
  visibility: hidden;
  transform: translateY(22px);
  transition: all var(--t-med);
}

#back-to-top.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

#back-to-top:hover {
  transform: translateY(-5px) scale(1.06);
  box-shadow: 0 16px 42px rgba(0, 212, 255, 0.48);
}

#back-to-top svg {
  width: 21px;
  height: 21px;
}

/* ==========================================================================
   23. RESPONSIVIDADE
   ========================================================================== */
@media (max-width: 1180px) {
  .nav-links { gap: 0; }
  .nav-links a { padding: 9px 10px; font-size: 0.845rem; }
}

@media (max-width: 1080px) {
  .nav-links { display: none; }
  .hamburger { display: flex; }
  .nav-cta { display: none; }

  .hero-inner {
    grid-template-columns: 1fr;
    gap: 48px;
  }

  .hero-visual {
    order: -1;
    max-width: 340px;
    margin-inline: auto;
