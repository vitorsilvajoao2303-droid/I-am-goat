  (function initCharts() {
    const canvas = $('#chart-percepcao');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    const DATA = [
      { label: 'Jovens',        oportunidade: 72, neutro: 16, ameaca: 12 },
      { label: 'Prof. TI',      oportunidade: 81, neutro: 12, ameaca: 7  },
      { label: 'Indústria',     oportunidade: 54, neutro: 21, ameaca: 25 },
      { label: 'Comércio',      oportunidade: 48, neutro: 24, ameaca: 28 },
      { label: 'Educação',      oportunidade: 64, neutro: 20, ameaca: 16 },
      { label: 'Saúde',         oportunidade: 59, neutro: 23, ameaca: 18 }
    ];

    function getColors() {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      return {
        oportunidade: isLight ? '#0aa06a' : '#2ce08a',
        neutro:       isLight ? '#d18a00' : '#ffb020',
        ameaca:       isLight ? '#d63030' : '#ff5252',
        text:         isLight ? '#3c4a63' : '#b3c0d8',
        grid:         isLight ? 'rgba(10,20,45,0.08)' : 'rgba(255,255,255,0.08)'
      };
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw(rect.width, rect.height);
    }

    function draw(w, h) {
      const colors = getColors();
      ctx.clearRect(0, 0, w, h);

      const padding = { top: 18, right: 14, bottom: 42, left: 42 };
      const chartW = w - padding.left - padding.right;
      const chartH = h - padding.top - padding.bottom;

      // Grade horizontal
      ctx.strokeStyle = colors.grid;
      ctx.lineWidth = 1;
      ctx.font = '11px "JetBrains Mono", monospace';
      ctx.fillStyle = colors.text;

      for (let i = 0; i <= 4; i++) {
        const y = padding.top + (chartH / 4) * i;
        ctx.beginPath();
        ctx.moveTo(padding.left, y);
        ctx.lineTo(padding.left + chartW, y);
        ctx.stroke();

        const value = 100 - (i * 25);
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';
        ctx.fillText(value + '%', padding.left - 9, y);
      }

      // Barras agrupadas
      const groupCount = DATA.length;
      const groupWidth = chartW / groupCount;
      const barWidth = Math.min(groupWidth / 3.9, 22);
      const gap = 5;

      DATA.forEach((d, i) => {
        const groupCenter = padding.left + groupWidth * i + groupWidth / 2;
        const values = [
          { v: d.oportunidade, c: colors.oportunidade },
          { v: d.neutro,       c: colors.neutro },
          { v: d.ameaca,       c: colors.ameaca }
        ];

        const totalWidth = (barWidth * 3) + (gap * 2);
        let startX = groupCenter - totalWidth / 2;

        values.forEach(item => {
          const barH = (item.v / 100) * chartH;
          const x = startX;
          const y = padding.top + chartH - barH;

          // Sombra suave
          ctx.fillStyle = item.c;
          ctx.globalAlpha = 0.92;
          roundRect(ctx, x, y, barWidth, barH, 4);
          ctx.fill();
          ctx.globalAlpha = 1;

          startX += barWidth + gap;
        });

        // Rótulo
        ctx.fillStyle = colors.text;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.font = '11px "Inter", sans-serif';
        ctx.fillText(d.label, groupCenter, padding.top + chartH + 12);
      });
    }

    function roundRect(context, x, y, width, height, radius) {
      const r = Math.min(radius, width / 2, height / 2);
      context.beginPath();
      context.moveTo(x + r, y);
      context.lineTo(x + width - r, y);
      context.quadraticCurveTo(x + width, y, x + width, y + r);
      context.lineTo(x + width, y + height - r);
      context.quadraticCurveTo(x + width, y + height, x + width - r, y + height);
      context.lineTo(x + r, y + height);
      context.quadraticCurveTo(x, y + height, x, y + height - r);
      context.lineTo(x, y + r);
      context.quadraticCurveTo(x, y, x + r, y);
      context.closePath();
    }

    resize();

    let rt;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = setTimeout(resize, 200);
    });

    window.addEventListener('site:themechange', resize);

    // Redesenha ao entrar em foco
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            resize();
          }
        });
      }, { threshold: 0.2 });
      io.observe(canvas);
    }
  })();

  /* ========================================================================
     14. PARALLAX SUAVE NO HERO
     ======================================================================== */
  (function initParallax() {
    if (prefersReducedMotion) return;

    const heroImg = $('.hero-bg img');
    const orb = $('.hero-orb');
    if (!heroImg) return;

    let ticking = false;

    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;

      requestAnimationFrame(() => {
        const y = window.scrollY;
        if (y < window.innerHeight * 1.2) {
          heroImg.style.transform = `scale(1.06) translateY(${y * 0.12}px)`;
          if (orb) orb.style.transform = `translateY(${y * 0.06}px)`;
        }
        ticking = false;
      });
    }, { passive: true });
  })();

  /* ========================================================================
     15. TICKER: DUPLICAÇÃO PARA LOOP CONTÍNUO
     ======================================================================== */
  (function initTicker() {
    const track = $('#ticker-track');
    if (!track) return;

    const clone = track.cloneNode(true);
    clone.setAttribute('aria-hidden', 'true');
    clone.removeAttribute('id');
    track.parentElement.appendChild(clone);
  })();

  /* ========================================================================
     16. ANO NO FOOTER
     ======================================================================== */
  (function initYear() {
    const el = $('#year');
    if (el) el.textContent = new Date().getFullYear();
  })();

  /* ========================================================================
     17. SCROLL SUAVE PARA LINKS INTERNOS (fallback)
     ======================================================================== */
  (function initSmoothScroll() {
    $$('a[href^="#"]').forEach(link => {
      link.addEventListener('click', e => {
        const href = link.getAttribute('href');
        if (!href || href === '#') return;

        const target = document.querySelector(href);
        if (!target) return;

        e.preventDefault();

        const navHeight = 84;
        const top = target.getBoundingClientRect().top + window.scrollY - navHeight;

        window.scrollTo({
          top: top < 0 ? 0 : top,
          behavior: prefersReducedMotion ? 'auto' : 'smooth'
        });
      });
    });
  })();

  /* ========================================================================
     18. EFEITO DE TILT NOS CARDS (DESKTOP)
     ======================================================================== */
  (function initTilt() {
    if (prefersReducedMotion) return;
    if (window.matchMedia('(hover: none)').matches) return;
    if (window.innerWidth < 1000) return;

    const cards = $$('.opp-card, .skill-card, .resp-card');

    cards.forEach(card => {
      card.addEventListener('mousemove', e => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = ((y - centerY) / centerY) * -3.2;
        const rotateY = ((x - centerX) / centerX) * 3.2;

        card.style.transform =
          `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-8px)`;
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = '';
      });
    });
  })();

  /* ========================================================================
     19. HIGHLIGHT DO LINK ATIVO NA NAVEGAÇÃO
     ======================================================================== */
  (function initActiveLink() {
    const links = $$('#nav-links a');
    const sections = links
      .map(l => document.querySelector(l.getAttribute('href')))
      .filter(Boolean);

    if (!sections.length || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          links.forEach(l => l.classList.remove('active'));
          const active = links.find(l => l.getAttribute('href') === '#' + entry.target.id);
          if (active) active.classList.add('active');
        }
      });
    }, {
      rootMargin: '-45% 0px -50% 0px',
      threshold: 0
    });

    sections.forEach(s => observer.observe(s));
  })();

  /* ========================================================================
     20. EASTER EGG: KONAMI CODE
     ======================================================================== */
  (function initEasterEgg() {
    const sequence = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight'];
    let pos = 0;

    document.addEventListener('keydown', e => {
      if (e.key === sequence[pos]) {
        pos++;
        if (pos === sequence.length) {
          pos = 0;
          document.body.style.transition = 'filter 0.6s ease';
          document.body.style.filter = 'hue-rotate(180deg)';
          setTimeout(() => {
            document.body.style.filter = '';
          }, 1600);
        }
      } else {
        pos = 0;
      }
    });
  })();

